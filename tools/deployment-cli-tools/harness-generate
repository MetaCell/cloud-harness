#!/usr/bin/env python

import argparse
from dataclasses import dataclass, field
import enum
import functools
import operator
import os
import pathlib
import logging
import sys
from typing import Optional

from ch_cli_tools import CHDeployConfig, ci
from ch_cli_tools.api import generate_ci_cd
from ch_cli_tools.openapi import LIB_NAME, ClientType, generate_clients, generate_models, generate_servers, get_dependencies
from ch_cli_tools.utils import confirm, discover_root_paths, generation_argv


def main():
    args = get_command_line_arguments()
    if isinstance(args, CiCdArguments):
        generate_pipelines(args)
        return
    get_dependencies()

    root_path = args.path.absolute() if args.path else pathlib.Path.cwd().absolute()
    app_name = root_path.name if args.path else args.app_name
    if args.path and args.app_name:
        logging.warning('Ignoring app_name flag because path was provided')

    # Check if applications folder exists, if not, go up until it's found
    while not (root_path / 'applications').exists():
        if root_path == root_path.parent:
            logging.error('Could not find applications folder')
            return
        root_path = root_path.parent

    should_generate = should_generate_interactive if args.is_interactive else lambda _: True

    if args.generate_models:
        generate_models(root_path, should_generate)

    if args.generate_servers:
        generate_servers(root_path, should_generate, app_name)

    if args.generate_clients:
        generate_clients(root_path, should_generate, app_name, args.client_name, args.client_types)


class GenerationMode(enum.Flag):
    CLIENTS = enum.auto()
    MODELS = enum.auto()
    SERVERS = enum.auto()

    @classmethod
    def all(cls):
        return functools.reduce(operator.or_, [cls.CLIENTS, cls.SERVERS])


@dataclass(frozen=True)
class CommandLineArguments:
    path: pathlib.Path
    app_name: Optional[str]
    is_interactive: bool
    generation_mode: GenerationMode
    client_name: Optional[str] = None
    client_types: ClientType = ClientType.all()

    @property
    def generate_models(self):
        return GenerationMode.MODELS in self.generation_mode

    @property
    def generate_servers(self):
        return GenerationMode.SERVERS in self.generation_mode

    @property
    def generate_clients(self):
        return GenerationMode.CLIENTS in self.generation_mode


@dataclass(frozen=True)
class CiCdArguments:
    paths: list[pathlib.Path] = field(default_factory=list)
    include: list[str] = field(default_factory=list)
    exclude: list[str] = field(default_factory=list)
    env: list[str] = field(default_factory=list)
    name: Optional[str] = None
    unsecured: bool = False
    registry_secret_name: str = ''


def generate_pipelines(args: CiCdArguments) -> None:
    cwd = pathlib.Path.cwd()
    if args.paths:
        root_paths = [cwd / path for path in args.paths]
    else:
        root_paths = discover_root_paths(cwd)
        if not root_paths:
            sys.exit('No deployment-configuration found in the current directory or its subdirectories: '
                     'pass the paths explicitly')
        print('No paths given, using (lowest priority first): ' +
              ' '.join(str(path.relative_to(cwd)) for path in root_paths), file=sys.stderr)

    config = CHDeployConfig(
        includes=args.include,
        excludes=args.exclude,
        pipeline=args.name,
        secured_gatekeepers=not args.unsecured,
        registry_secret_name=args.registry_secret_name,
        ci_runner=os.environ.get('CH_GITHUB_RUNNER'),
    )
    try:
        ci.pipeline_name(config)
    except ValueError as e:
        sys.exit(str(e))

    generation_argv.set(sys.argv)
    written = generate_ci_cd(root_paths, config, envs=args.env)
    if not written:
        sys.exit(f'No pipeline generated: {root_paths[-1] / "deployment-configuration"} has no '
                 'codefresh-template-<env>.yaml or github-template-<env>.yaml for the requested environments')
    for path in written:
        print(path.relative_to(cwd) if path.is_relative_to(cwd) else path)


def get_command_line_arguments() -> CommandLineArguments | CiCdArguments:
    parser = argparse.ArgumentParser(description='Walks the filesystem inside the ./applications folder to create and update applications scaffolding.')

    common_arguments = argparse.ArgumentParser(add_help=False)
    common_arguments.add_argument('path', metavar='path', nargs='?', default=None, type=pathlib.Path,
                                  help='Base path of the application. If used, the -a/--app_name flag is ignored.')
    common_arguments.add_argument('-i', '--interactive', dest='is_interactive', action="store_true",
                                  help='Asks before generate')
    common_arguments.add_argument('-a', '--app-name', dest='app_name', action="store", default=None,
                                  help='Generate only for a specific application')

    clients_arguments = argparse.ArgumentParser(add_help=False)
    clients_arguments.add_argument('-cn', '--client-name', dest='client_name', action='store', default=None,
                                   help='specify client prefix name')
    client_type_group = clients_arguments.add_mutually_exclusive_group(required=False)
    client_type_group.add_argument('-t', '--ts-only', dest='client_types', action='store_const', const=ClientType.TS_CLIENT,
                                   help='Generate only typescript clients')
    client_type_group.add_argument('-p', '--python-only', dest='client_types', action='store_const', const=ClientType.PYTHON_CLIENT,
                                   help='Generate only python clients')
    clients_arguments.set_defaults(client_types=ClientType.all())

    subparsers = parser.add_subparsers(title='generation modes', required=True)

    all_parser = subparsers.add_parser('all', parents=[common_arguments, clients_arguments],
                                       help='Generate server stubs and client libraries')
    all_parser.set_defaults(generation_mode=GenerationMode.all())

    clients_parser = subparsers.add_parser('clients', parents=[common_arguments, clients_arguments],
                                           help='Generate only client libraries')
    clients_parser.set_defaults(generation_mode=GenerationMode.CLIENTS)

    servers_parser = subparsers.add_parser('servers', parents=[common_arguments],
                                           help='Generate only server stubs')
    servers_parser.set_defaults(generation_mode=GenerationMode.SERVERS)

    models_parser = subparsers.add_parser('models', parents=[common_arguments],
                                          help='Special flag, used to regenerate only model libraries')
    models_parser.set_defaults(generation_mode=GenerationMode.MODELS)

    for mode_parser in (all_parser, clients_parser, servers_parser, models_parser):
        mode_parser.set_defaults(arguments=CommandLineArguments)

    ci_cd_parser = subparsers.add_parser(
        'ci-cd',
        help='Generate the CI/CD pipelines from the templates in deployment-configuration',
        description='Generate a pipeline for each environment with a codefresh-template-<env>.yaml '
        '(deployment/ci--<name>--<env>.yaml) or github-template-<env>.yaml '
        '(.github/workflows/ci--<name>--<env>.yaml) in the deployment-configuration of the last path, '
        'even an empty one: the templates of the paths before it are merged in, but never add a pipeline. '
        'GitHub Actions jobs run on the runner named by the CH_GITHUB_RUNNER GitHub variable, falling '
        'back to the CH_GITHUB_RUNNER environment variable at generation time (default: ubuntu-latest).')
    ci_cd_parser.add_argument('paths', metavar='paths', nargs='*', type=pathlib.Path, default=[],
                              help='Base paths of the deployment, lowest priority first, as harness-deployment '
                              'takes them. Omit to use the direct subdirectories of the current directory that '
                              'contain a deployment-configuration, then the current directory itself')
    ci_cd_parser.add_argument('-i', '--include', dest='include', action='append', default=[],
                              help='Application the pipelines deploy, with its dependencies; repeat for more '
                              '(default: every application)')
    ci_cd_parser.add_argument('-ex', '--exclude', dest='exclude', action='append', default=[],
                              help='Application to exclude from the pipelines; repeat for more')
    ci_cd_parser.add_argument('-e', '--env', dest='env', action='append', default=[],
                              help='Generate only this environment; repeat for more. Combine environments with '
                              'dashes (e.g. research-dev): each one needs a template (default: every environment '
                              'with a template)')
    ci_cd_parser.add_argument('--name', dest='name', default=None,
                              help='Name of the pipelines in their file names (default: the included '
                              'applications joined with dashes, `all` when none is)')
    ci_cd_parser.add_argument('-u', '--disable-security', dest='unsecured', action='store_true',
                              help='The deployment runs without secured gatekeepers (no rollout wait for them)')
    ci_cd_parser.add_argument('-rsn', '--registry-secret-name', dest='registry_secret_name', default='',
                              help='The deployment uses a registry secret: its value comes from the '
                              'K8S_SA_JSON pipeline secret')
    ci_cd_parser.set_defaults(arguments=CiCdArguments)

    args = vars(parser.parse_args())
    arguments = args.pop('arguments')
    return arguments(**args)


def should_generate_interactive(resource: str) -> bool:
    return confirm(f'Do you want to generate {resource}?')


if __name__ == "__main__":
    main()
